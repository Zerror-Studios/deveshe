# Deveshe Dreams storefront — variable names only (PRD-002 SF-7/SF-22).
# Copy to .env.local and fill in. NEXT_PUBLIC_* values are public.

# Server-only: gateway origin; /v1/graphql is proxied to it (src/middleware.js)
API_GATEWAY_URL=

# Server-only, optional (PRD-002 R2-C1): the gateway's EDGE_SHARED_SECRET,
# sent as x-zcom-edge-secret on proxied and server-side calls so strict
# tenant mode trusts x-tenant-domain and x-zcom-client-ip. Never prefix it
# with NEXT_PUBLIC_.
EDGE_SHARED_SECRET=

# Required: the brand's production domain (tenant selection by host)
NEXT_PUBLIC_TENANT_DOMAIN=

# Optional: extra image hosts, comma-separated (e.g. the tenant S3 bucket)
IMAGE_REMOTE_HOSTS=

# Analytics IDs: no defaults, an unset id loads no tag (PRD-014 FR-1.9).
# Tags load only after the shopper's cookie consent (utils/consent.util.js).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Optional: "true" sends the CSP as Content-Security-Policy-Report-Only
CSP_REPORT_ONLY=
